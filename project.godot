;   param=value ; assign values to parameters

config_version=5

[application]

config/name="cc3d-steam-multiplayer-rewrite"
config/tags=PackedStringArray("game")
run/main_scene="uid://n7uagpgfwrrb"
config/use_custom_user_dir=true
config/custom_user_dir_name="reckdave-cc3d"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://djan0j7blyrwx"

[audio]

buses/default_bus_layout="uid://d4dy1wig4o451"

[autoload]

Global="*res://assets/scripts/autoload/Global.gd"
Data="*res://assets/scripts/autoload/Data.gd"
Util="*res://assets/scripts/autoload/Util.gd"
Enums="*res://assets/scripts/autoload/Enums.gd"
SignalBus="*res://assets/scripts/autoload/SignalBus.gd"
GameHandler="*res://assets/scripts/autoload/GameHandler.gd"
