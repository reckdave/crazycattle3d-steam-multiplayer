[ext_resource type="Theme" uid="uid://carsydbdoxb7m" path="res://assets/themes/buttons_main.tres" id="1"]

[sub_resource type="GDScript" id="GDScript_uroli"]
script/source = "extends Control

@onready var button : CheckBox = $Enable
@export var cosmeticName : String = \"NONE\"

func _ready() -> void:
	button.text = cosmeticName
	if Data.data.game.cosmetics.has(cosmeticName):
		button.button_pressed = true

func _on_enable_pressed() -> void:
	if button.button_pressed:
		Data.data.game.cosmetics.append(cosmeticName)
		#Global.pdata.cosmetics.append(cosmeticName)
		Data.save()
	else:
		Data.data.game.cosmetics.erase(cosmeticName)
		#Global.pdata.cosmetics.erase(cosmeticName)
		Data.save()
"

[node name="CosmeticUI" type="Control"]
