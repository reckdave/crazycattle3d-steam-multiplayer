[sub_resource type="GDScript" id="GDScript_m6bep"]
script/source = "extends Control

@onready var container : VBoxContainer = $List

func _on_button_press(button : Button):
    button.queue_free()

func notify(text : String, length : float):
    var button : Button = Button.new()
    button.text = text
    button.pressed.connect(_on_button_press.bind(button))
    container.add_child(button)
    
    await get_tree().create_timer(length).timeout
    if button: button.queue_free()
"

